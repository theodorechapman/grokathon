 void motronic175_state::p1_w(u8 data)
 {
-	if (data != m_p1_last)
+	if (data != m_p1_last)
+	{
 		++m_p1_transitions;
+		logerror(
+				"SIGOUT kind=p1 cycles=%llu old=%02x value=%02x changed=%02x\n",
+				m_maincpu->total_cycles(),
+				m_p1_last,
+				data,
+				m_p1_last ^ data);
+	}
 	m_p1_last = data;
 }
 
