diff --git a/src/devices/cpu/mcs51/sab80c535_irq.cpp b/src/devices/cpu/mcs51/sab80c535_irq.cpp
new file mode 100644
--- /dev/null
+++ b/src/devices/cpu/mcs51/sab80c535_irq.cpp
@@ -0,0 +1,92 @@
+// license:BSD-3-Clause
+// copyright-holders:Steve Ellenoff, Manuel Abadia, Couriersud
+
+#include "emu.h"
+#include "sab80c535.h"
+
+void sab80c535_device::check_irqs()
+{
+	if (!BIT(m_ie, IE_A))
+		return;
+
+	u16 pending =
+			(BIT(m_tcon, TCON_IE0) << 0) |
+			(BIT(m_tcon, TCON_TF0) << 1) |
+			(BIT(m_tcon, TCON_IE1) << 2) |
+			(BIT(m_tcon, TCON_TF1) << 3) |
+			((BIT(m_scon, SCON_RI) | BIT(m_scon, SCON_TI)) << 4) |
+			((BIT(m_ircon, IRCON_TF2) | BIT(m_ircon, IRCON_EXF2)) << 5) |
+			((m_ircon & 0x3f) << 6);
+	const u16 enabled = (m_ie & 0x3f) | (u16(m_ien1 & 0x3f) << 6);
+	pending &= enabled;
+	if (!pending)
+		return;
+
+	static constexpr u8 polling_order[12] = { 0, 6, 1, 7, 2, 8, 3, 9, 4, 10, 5, 11 };
+	static constexpr u8 vectors[12] = {
+		0x03, 0x0b, 0x13, 0x1b, 0x23, 0x2b,
+		0x43, 0x4b, 0x53, 0x5b, 0x63, 0x6b
+	};
+
+	int selected = -1;
+	int selected_priority = -1;
+	for (u8 source : polling_order)
+	{
+		if (!BIT(pending, source))
+			continue;
+		const u8 pair = source < 6 ? source : source - 6;
+		const int priority = BIT(m_ip, pair) | (BIT(m_iph, pair) << 1);
+		if (priority > selected_priority)
+		{
+			selected = source;
+			selected_priority = priority;
+		}
+	}
+
+	if (m_irq_active && selected_priority <= m_cur_irq_prio)
+		return;
+
+	if (selected == 0)
+	{
+		if (m_last_op == 0x20 && m_last_bit == 0xb2)
+			m_pc = m_ppc + 3;
+		standard_irq_callback(0, m_pc);
+	}
+	else if (selected == 2)
+	{
+		if (m_last_op == 0x20 && m_last_bit == 0xb3)
+			m_pc = m_ppc + 3;
+		standard_irq_callback(1, m_pc);
+	}
+
+	push_pc();
+	m_pc = vectors[selected];
+	m_inst_cycles += 2;
+	m_cur_irq_prio = selected_priority;
+	m_irq_active |= 1 << selected_priority;
+
+	switch (selected)
+	{
+	case 0:
+		if (BIT(m_tcon, TCON_IT0))
+			set_ie0(0);
+		break;
+	case 1:
+		set_tf0(0);
+		break;
+	case 2:
+		if (BIT(m_tcon, TCON_IT1))
+			set_ie1(0);
+		break;
+	case 3:
+		set_tf1(0);
+		break;
+	case 7:
+	case 8:
+	case 9:
+	case 10:
+	case 11:
+		m_ircon &= ~(1 << (selected - 6));
+		break;
+	}
+}
diff --git a/src/devices/cpu/mcs51/sab80c535_peripherals.cpp b/src/devices/cpu/mcs51/sab80c535_peripherals.cpp
new file mode 100644
--- /dev/null
+++ b/src/devices/cpu/mcs51/sab80c535_peripherals.cpp
@@ -0,0 +1,130 @@
+// license:BSD-3-Clause
+// copyright-holders:Steve Ellenoff, Manuel Abadia, Couriersud
+
+#include "emu.h"
+#include "sab80c535.h"
+
+void sab80c535_device::request_capture(u8 channel)
+{
+	m_capture_pending |= 1 << channel;
+	m_capture_cycles = m_inst_cycles + 1;
+}
+
+void sab80c535_device::tick_capture()
+{
+	if (!m_capture_pending || !m_capture_cycles || --m_capture_cycles)
+		return;
+
+	if (BIT(m_capture_pending, 0))
+		m_rcap2 = m_t2;
+	for (unsigned channel = 1; channel < 4; channel++)
+	{
+		if (BIT(m_capture_pending, channel))
+		{
+			m_cc[(channel - 1) * 2] = u8(m_t2);
+			m_cc[(channel - 1) * 2 + 1] = u8(m_t2 >> 8);
+		}
+	}
+	m_capture_pending = 0;
+}
+
+void sab80c535_device::tick_adc()
+{
+	if (!m_adc_cycles || --m_adc_cycles)
+		return;
+
+	// Preserve the existing MAME callback's 7-bit input convention.
+	m_addat = m_an_func[m_adcon & 7]() * 2;
+	m_ircon |= 0x01;
+	if (BIT(m_adcon, 3))
+		m_adc_cycles = 13;
+	else
+		m_adcon &= ~(1 << ADCON_BSY);
+}
+
+void sab80c535_device::tick_strobes()
+{
+	if (m_wdt_clear_cycles && !--m_wdt_clear_cycles)
+		m_ie &= ~(1 << IEN_WDT);
+	if (m_swdt_clear_cycles && !--m_swdt_clear_cycles)
+		m_ien1 &= ~(1 << IEN1_SWDT);
+}
+
+void sab80c535_device::compare_timer2()
+{
+	const u16 values[4] = {
+		m_rcap2,
+		u16(u16(m_cc[0]) | (u16(m_cc[1]) << 8)),
+		u16(u16(m_cc[2]) | (u16(m_cc[3]) << 8)),
+		u16(u16(m_cc[4]) | (u16(m_cc[5]) << 8))
+	};
+	for (unsigned channel = 0; channel < 4; channel++)
+	{
+		if (BIT(m_ccen, channel * 2, 2) == 2 && m_t2 == values[channel])
+			m_ircon |= 1 << (channel + 2);
+	}
+}
+
+void sab80c535_device::increment_timer2()
+{
+	const u16 previous = m_t2;
+	m_t2++;
+	if (m_t2 == 0 && previous == 0xffff)
+	{
+		m_ircon |= 1 << IRCON_TF2;
+		if (BIT(m_t2con, 4) && !BIT(m_t2con, 3))
+			m_t2 = m_rcap2;
+	}
+	compare_timer2();
+}
+
+void sab80c535_device::update_timer_t2(int cycles)
+{
+	while (cycles--)
+	{
+		tick_strobes();
+		tick_adc();
+		tick_capture();
+
+		const u8 mode = m_t2con & 0x03;
+		if (mode == 2)
+		{
+			while (m_t2_cnt > 0)
+			{
+				increment_timer2();
+				m_t2_cnt--;
+			}
+		}
+		else if (mode == 1 || (mode == 3 && !BIT(m_last_line_state, MCS51_T2_LINE)))
+		{
+			if (!BIT(m_t2con, 7) || (++m_timer2_prescaler & 1) == 0)
+				increment_timer2();
+		}
+	}
+}
+
+void sab80c535_device::handle_8bit_uart_clock(int source)
+{
+	mcs51_cpu_device::handle_8bit_uart_clock(source);
+}
+
+void sab80c535_device::handle_irq(int irqline, int state, u32 new_state, u32 tr_state)
+{
+	if (irqline == MCS51_T2_LINE)
+	{
+		if (BIT(tr_state, MCS51_T2_LINE))
+			m_t2_cnt++;
+		return;
+	}
+	if (irqline == MCS51_T2EX_LINE)
+	{
+		if (BIT(tr_state, MCS51_T2EX_LINE) && BIT(m_t2con, 4) && BIT(m_t2con, 3))
+		{
+			m_t2 = m_rcap2;
+			if (BIT(m_ien1, 7))
+				m_ircon |= 1 << IRCON_EXF2;
+		}
+		return;
+	}
+	mcs51_cpu_device::handle_irq(irqline, state, new_state, tr_state);
+}
